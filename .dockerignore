# The Dockerfile runs `npm ci` inside the image, then `COPY . .`. Without this
# file that copy would clobber the freshly-installed, correct-arch node_modules
# with the host's, and drag in .git and local reports — bloating the image and
# breaking reproducibility.
node_modules

# Every dot-file/dir at the root — VCS, CI config, editor and local-tool state,
# env files that may hold secrets. None of it is needed to run the suite.
.*

# Generated test / report output
test-results
playwright-report
blob-report
playwright/.cache
allure-results
allure-report
allure-history
results.json

# Docs and logs are not needed to run tests
docs
*.log
Thumbs.db
